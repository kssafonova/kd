ommendations>p{font-size:11px;letter-spacing:.1em;margin-bottom:15px}.added-recommendations>div{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.added-recommendations button{text-align:left;position:relative}.added-recommendations img{height:225px;object-fit:cover}.added-recommendations span,.added-recommendations small,.added-recommendations b{display:block;margin-top:6px}.added-recommendations span{font-size:12px}.added-recommendations small{color:#888}.added-recommendations b{font-weight:400}.added-recommendations em{position:absolute;left:8px;top:8px;background:#ae7650;color:#fff;padding:5px;font-size:9px;font-style:normal}.plp-added-modal>aside{margin-top:25px;background:#f5f4f1;padding:16px;display:flex;align-items:center;gap:12px}.plp-added-modal>aside svg{width:25px;height:25px}@keyframes modalIn{from{opacity:.35;transform:translateY(12px) scale(.99)}}
.pdp-price{display:flex;align-items:center;gap:12px;margin:20px 0}.pdp-price strong{font-size:23px;font-weight:400}.pdp-price.sale strong{color:#a86d42}.pdp-price del{color:#969691}.pdp-price mark{background:#f2e5da;color:#a06443;padding:5px 8px;font-size:11px}

@media(max-width:900px){.hero-nav{display:flex;height:auto;justify-content:flex-start;gap:27px;overflow-x:auto;padding:0 16px;scrollbar-width:none}.hero-nav button{padding:18px 0 14px}.plp-flow,.plp-added{align-items:flex-end;padding:0}.plp-modal{width:100%;max-height:94vh;grid-template-columns:1fr;border-radius:15px 15px 0 0}.plp-modal-media{min-height:0;height:31vh}.plp-modal-info{padding:26px 17px 22px}.plp-modal-info h2{font-size:24px}.modal-price{margin:13px 0 18px}.plp-added-modal{width:100%;max-height:94vh;border-radius:15px 15px 0 0;padding:26px 16px 24px}.added-product{grid-template-columns:95px 1fr 24px;gap:14px}.added-product img{height:110px}.added-product h2{font-size:20px}.added-actions{grid-template-columns:1fr}.added-recommendations>div{overflow-x:auto;display:flex}.added-recommendations button{min-width:47vw}.added-recommendations img{height:190px}}

/* Quantity, ready-made bundles, post-editorial recommendations */
.quantity-sizes .size-row,.modal-sizes .size-option,.size-sheet>.size-option{min-height:48px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;border-bottom:1px solid #ddd;padding:0 12px}.quantity-sizes .size-row:last-child,.modal-sizes .size-option:last-child,.size-sheet>.size-option:last-of-type{border-bottom:0}.quantity-sizes .size-row.active,.modal-sizes .size-option.active,.size-sheet>.size-option.active{box-shadow:inset 0 0 0 1px #111}.quantity-sizes .size-row>button,.modal-sizes .size-option>button,.size-sheet>.size-option>button{width:100%;height:100%;border:0;padding:14px 0;text-align:left}.quantity-sizes .size-row>button{border:0}.choose-size{font-size:9px;letter-spacing:.09em;color:#888}.quantity-control{height:32px;display:flex;align-items:center;border:1px solid #bcbcb8;background:#fff}.quantity-control button{width:32px!important;height:30px!important;display:grid!important;place-items:center!important;padding:7px!important;border:0!important}.quantity-control button svg{width:14px;height:14px}.quantity-control span{min-width:24px;text-align:center}.total-cta{display:flex;align-items:center;justify-content:space-between;gap:20px}.total-cta b{font-weight:400;white-space:nowrap}.bundle{border-top:1px solid #d7d7d2;padding:22px 0 20px;margin-top:5px}.bundle-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.bundle-heading p{font-size:8px;letter-spacing:.16em;color:#8e755f;margin:0 0 5px}.bundle-heading h3{font-size:12px;letter-spacing:.09em;margin:0}.bundle-heading>span{font-size:9px;color:#777}.bundle-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.bundle-products article{min-width:0}.bundle-products article>div{position:relative;background:#f4f2ee}.bundle-products img{aspect-ratio:1/1.12;object-fit:cover}.bundle-products i{position:absolute;top:6px;right:6px;width:18px;height:18px;border-radius:50%;background:#fff;display:grid;place-items:center;font-style:normal;font-size:9px}.bundle-products article>span,.bundle-products article>small,.bundle-products article>b{display:block;margin-top:6px}.bundle-products article>span{font-size:9px;line-height:1.25;min-height:23px}.bundle-products article>small{font-size:7px;color:#888;min-height:18px}.bundle-products article>b{font-size:9px;font-weight:400}.bundle-buy{margin-top:15px}.post-rich-recommendations{padding:110px 0 50px}.post-rich-recommendations>.section-head{text-align:center}.post-rich-recommendations>.section-head h2{font-size:47px}.post-rich-recommendations>div:last-child{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.plp-modal-media>span,.product-image .color-change,.product-image .image-discount{display:none!important}

/* Editorial collection and capsule pages */
.editorial-page{padding-bottom:120px}.editorial-cover{position:relative;margin:0 2vw;height:calc(100vh - 109px);min-height:620px;color:white;overflow:hidden}.editorial-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.28),transparent 58%)}.editorial-cover>img{height:100%;object-fit:cover}.editorial-cover>div{position:absolute;z-index:1;left:50%;bottom:11%;transform:translateX(-50%);text-align:center;width:90%;text-shadow:0 2px 20px #0007}.editorial-cover p{font-size:10px;letter-spacing:.35em}.editorial-cover h1{font:400 clamp(54px,7vw,100px)/1 var(--serif);text-transform:upperc