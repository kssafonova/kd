@import url('https://fonts.googleapis.com/css2?family=Tenor+Sans&display=swap');
:root{--ink:#181a19;--muted:#797b78;--line:#deded9;--cream:#f3f0ea;--dark:#233b3f;--accent:#aa7650;--serif:'Tenor Sans',Arial,sans-serif;--sans:'Tenor Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:#fff;font-family:var(--sans);font-size:14px;font-weight:400}button,input,select{font:inherit;color:inherit}button{border:0;background:none;cursor:pointer}svg{display:block;width:24px;height:24px}img{display:block;width:100%}main{min-height:100vh}.promo{height:31px;background:#273d3f;color:white;font-size:10px;letter-spacing:.12em;text-align:center;display:flex;align-items:center;justify-content:center;gap:16px}.promo button{color:white;text-decoration:underline;text-underline-offset:3px;font-size:9px}.header{height:78px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 32px;border-bottom:1px solid #eee;position:sticky;top:0;background:rgba(255,255,255,.96);backdrop-filter:blur(14px);z-index:20}.header-left,.header-actions{display:flex;align-items:center;gap:22px}.header-actions{justify-content:flex-end}.header-actions button{line-height:1;position:relative;padding:3px}.header-actions svg{width:27px;height:27px}.header-actions .bag svg{width:29px;height:29px}.bag b{position:absolute;right:-7px;top:-8px;background:#bf8b57;color:white;border-radius:50%;width:17px;height:17px;font:9px var(--sans);display:grid;place-items:center}.hamburger{width:24px;display:grid;gap:5px;padding:2px}.hamburger i{height:1.5px;background:#111;width:100%}.boutiques{display:flex;align-items:center;gap:8px;font-size:12px}.boutiques svg{width:23px;height:23px}.logo{font:400 25px/1 var(--serif);letter-spacing:-.035em}.hero{height:calc(100vh - 109px);min-height:540px;position:relative;overflow:hidden;background:#ddd;touch-action:pan-y}.hero>img{height:100%;object-fit:cover;transition:.45s ease}.hero:nth-child(1)>img{object-position:center}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(17,15,12,.45),transparent 55%)}.hero.right .hero-shade{background:linear-gradient(270deg,rgba(9,14,19,.6),transparent 65%)}.hero-copy{position:absolute;left:8%;top:50%;transform:translateY(-50%);color:#fff;max-width:420px;text-shadow:0 1px 20px rgba(0,0,0,.25)}.hero.right .hero-copy{left:auto;right:9%;text-align:left}.hero-copy p,.section-head p,.editorial p,.manifest p{font-size:11px;letter-spacing:.2em;margin:0 0 17px}.hero-copy h1{font:400 clamp(58px,7vw,104px)/.92 var(--serif);margin:0 0 20px}.hero-copy span{font:400 18px/1.35 var(--serif);display:block}.hero-copy button{color:white;border-bottom:1px solid rgba(255,255,255,.8);padding:18px 0 7px;margin-top:20px;font-size:11px;letter-spacing:.12em}.hero-copy button b{margin-left:20px}.hero-arrow{position:absolute;top:50%;color:#fff;opacity:.8;padding:20px}.hero-arrow svg{width:42px;height:42px}.hero-arrow.prev{left:15px;transform:rotate(180deg)}.hero-arrow.next{right:15px}.hero-dots{position:absolute;bottom:25px;left:50%;transform:translateX(-50%);display:flex;gap:10px}.hero-dots button{width:5px;height:5px;padding:0;border-radius:50%;background:#ddd}.hero-dots button.active{background:#fff;transform:scale(1.5)}.hero-nav{height:64px;display:flex;align-items:center;justify-content:center;gap:52px;border-bottom:1px solid var(--line)}.hero-nav button{font:400 10px var(--serif);letter-spacing:.08em;padding:23px 0 17px;border-bottom:1px solid transparent}.hero-nav button.active{border-color:#111}.section{padding:105px 3vw}.section-head{text-align:center;margin-bottom:48px}.section-head p{color:#806f60}.section-head h2,.section-head h1{font:400 clamp(38px,4.2vw,64px)/1.05 var(--serif);margin:0;text-transform:uppercase}.category-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:280px 280px;gap:12px}.category-card{position:relative;overflow:hidden;text-align:left;color:#fff;padding:30px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end}.category-card:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 50%,rgba(0,0,0,.55))}.category-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.7s}.category-card:hover img{transform:scale(1.035)}.category-card span,.category-card b{position:relative;z-index:1}.category-card span{font:400 31px var(--serif)}.category-card b{font-size:9px;letter-spacing:.12em;margin-top:8px}.category-card.c0{grid-column:span 7;grid-row:span 2}.category-card.c1{grid-column:span 5}.category-card.c2,.category-card.c3{grid-column:span 2.5}.category-card.c2{grid-column:8/span 2}.category-card.c3{grid-column:10/span 3}.category-card.c1 img,.category-card.c2 img{object-fit:cover}.editorial{min-height:720px;background:#dde4e2;display:grid;grid-template-columns:62% 38%;align-items:center}.editorial img{width:100%;height:720px;object-fit:cover}.editorial div{padding:8vw}.editorial h2{font:400 61px var(--serif);margin:0 0 20px}.editorial span{font:400 17px/1.5 var(--serif)}.editorial button,.manifest button,.section-head.row>button{display:block;margin-top:36px;font-size:10px;letter-spacing:.14em;border-bottom:1px solid;padding:0 0 7px}.section-head.row{display:flex;justify-content:space-between;text-align:left;align-items:flex-end}.product-row,.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}.product-grid{grid-template-columns:repeat(3,1fr);gap:44px 24px