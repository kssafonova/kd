backdrop-filter:none;text-shadow:0 1px 18px rgba(0,0,0,.3)}
.view-home .hamburger i{background:#fff}.view-home .bag b{background:var(--sale);text-shadow:none}
.view-home .hero{height:calc(100vh - 31px);min-height:660px}
.hero-media{position:absolute;inset:0;display:grid;grid-template-columns:1fr;height:100%}
.hero-media.split-media{grid-template-columns:1fr 1fr}
.hero-media img{width:100%;height:100%;object-fit:cover;min-width:0}
.hero-media.split-media img:first-child{object-position:center}.hero-media.split-media img:last-child{object-position:center}
.hero-mobile-video,.hero-mobile-search{display:none}
.view-home .hero-shade{background:linear-gradient(180deg,rgba(0,0,0,.32),rgba(0,0,0,.04) 34%,rgba(0,0,0,.3))}
.view-home .hero.right .hero-shade{background:linear-gradient(180deg,rgba(0,0,0,.28),rgba(0,0,0,.02) 35%,rgba(0,0,0,.3))}
.view-home .editorial-hero .hero-copy{left:50%;right:auto;top:50%;transform:translate(-50%,-50%);text-align:center;max-width:760px;width:min(84vw,760px)}
.view-home .editorial-hero .hero-copy h1{font-size:clamp(62px,7.3vw,114px);letter-spacing:.04em}
.view-home .hero-nav{position:absolute;z-index:3;bottom:0;left:0;width:100%;height:62px;border:0;color:#fff;gap:42px;background:linear-gradient(0deg,rgba(0,0,0,.32),transparent)}
.view-home .hero-nav button{border-color:transparent;text-shadow:0 1px 12px rgba(0,0,0,.55)}
.view-home .hero-nav button.active{border-color:#fff}
.view-home .hero-dots{bottom:78px;z-index:3}

/* Detailed quick-view and information panel */
.quick-description{font-size:11px!important;line-height:1.65;text-transform:none!important;color:#555;margin:17px 0 10px}
.quick-info-link{display:flex;align-items:center;justify-content:space-between;width:100%;font-size:9px;letter-spacing:.07em;text-decoration:underline;padding:8px 0 12px;border-bottom:1px solid #cfcfcb}
.quick-info-link svg{width:14px;height:14px}
.product-info-drawer{position:absolute;z-index:6;right:0;top:0;width:min(560px,100vw);height:100%;background:#fff;overflow:auto;box-shadow:-16px 0 46px rgba(0,0,0,.18);animation:slideLeft .2s ease}
.product-info-drawer>header{height:48px;background:#263a3e;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 23px;position:sticky;top:0;z-index:1}
.product-info-drawer>header span{font-size:10px;letter-spacing:.08em}.product-info-drawer>header button{color:#fff}.product-info-drawer>header svg{width:18px;height:18px}
.product-info-drawer>div{padding:34px 30px 70px}.product-info-drawer section{border-bottom:1px solid #d2d2ce;padding:0 0 25px;margin-bottom:28px}
.product-info-drawer h2{font-size:16px;margin:0 0 11px}.product-info-drawer h3{font-size:10px;margin:15px 0 5px}.product-info-drawer p,.product-info-drawer li,.product-info-drawer dl{font-size:10px;line-height:1.55;color:#444}
.product-info-drawer dl{margin:0}.product-info-drawer dl>div{display:flex;justify-content:space-between;padding:5px 0}.product-info-drawer dt,.product-info-drawer dd{margin:0}.product-info-drawer ul{list-style:none;padding:0;margin:0}.product-info-drawer li{padding:4px 0;text-transform:uppercase}

/* Right-edge post-add drawer */
.plp-added{align-items:stretch;justify-content:flex-end;padding:0}
.plp-added .overlay-bg{background:rgba(0,0,0,.58)}
.plp-added-modal{margin-left:auto;width:min(610px,100vw);height:100%;max-height:none;padding:35px 40px 0;box-shadow:-12px 0 45px rgba(0,0,0,.18);animation:slideLeft .24s ease;display:flex;flex-direction:column}
.plp-added-modal>.close{position:fixed;right:20px;top:16px;width:32px;height:32px;border-radius:50%;background:#fff;display:grid;place-items:center}.plp-added-modal>.close svg{width:20px;height:20px}
.added-drawer-head{display:flex;align-items:center;justify-content:space-between;padding:0 45px 22px 0}.added-drawer-head .added-kicker{margin:0;font-size:12px}.added-drawer-head span{font-size:8px;color:#888;letter-spacing:.08em}
.plp-added-modal .added-product{grid-template-columns:145px 1fr;gap:24px;align-items:start;padding-bottom:30px}.plp-added-modal .added-product img{height:165px}.plp-added-modal .added-product h2{font:400 18px/1.25 var(--serif);text-transform:uppercase}.plp-added-modal .added-product span{font-size:10px}.plp-added-modal .added-product b{margin-top:auto}
.plp-added-modal .added-recommendations{padding:28px 0 20px}.plp-added-modal .added-recommendations>p{font-size:12px;margin:0 0 18px}.plp-added-modal .added-recommendations>div{grid-template-columns:1fr 1fr;gap:12px}.plp-added-modal .added-recommendations img{height:255px;background:#f2f0eb}.plp-added-modal .added-recommendations span{font-size:10px;text-transform:uppercase}.plp-added-modal .added-recommendations small{font-size:9px}.plp-added-modal .added-recommendations b{font-size:11px}
.plp-added-modal>aside{margin-top:auto}.added-sticky{position:sticky;bottom:0;background:#fff;padding:14px 0 30px}.added-sticky .primary{margin:0}

@media(max-width:900px){
  .view-home .header{top:25px;height:70px}.view-home .hero{height:calc(100svh - 25px);min-height:620px}
  .hero-media.split-media{grid-template-columns:1fr}.editorial-hero .hero-media{display:none}.editorial-hero .hero-mobile-video{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .view-home .hero-shade{background:linear-gradient(180deg,rgba(0,0,0,.34),transparent 42%,rgba(0,0,0,.52))}
  .view-home .editorial-hero .hero-copy,.view-home .hero-copy,.view-home .hero.right .hero-copy{left:20px;right:20px;bottom:98px;top:auto;transform:none;te