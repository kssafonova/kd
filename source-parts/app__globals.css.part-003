g-top:25px;margin-top:25px}@keyframes slide{from{transform:translateX(-30px);opacity:.5}}@keyframes slideLeft{from{transform:translateX(30px);opacity:.5}}
@media(max-width:900px){body{font-size:12px}.promo{height:25px}.header{height:64px;padding:0 14px}.header-left{gap:8px}.boutiques{font-size:0}.boutiques span{font-size:20px}.logo{font-size:20px}.header-actions{gap:13px}.header-actions button{font-size:21px}.header-actions button:nth-child(3){display:none}.hero{height:74vh;min-height:520px}.hero>img{object-position:center}.hero-shade,.hero.right .hero-shade{background:linear-gradient(0deg,rgba(0,0,0,.55),transparent 55%)}.hero-copy,.hero.right .hero-copy{left:25px;right:25px;top:auto;bottom:65px;transform:none;text-align:center;max-width:none}.hero-copy h1{font-size:58px}.hero-copy span{font-size:17px}.hero-arrow{display:none}.hero-nav{display:none}.section{padding:68px 14px}.section-head h2,.section-head h1{font-size:38px}.category-grid{display:flex;overflow:auto;scroll-snap-type:x mandatory;gap:8px}.category-card{min-width:84vw;height:500px;scroll-snap-align:center}.editorial{display:block;position:relative;min-height:650px}.editorial img{height:650px}.editorial:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#0a1a25aa,transparent)}.editorial div{position:absolute;z-index:2;bottom:30px;color:white;padding:30px}.editorial h2{font-size:52px}.product-row{display:flex;overflow:auto;gap:10px}.product-row .product-card{min-width:70vw}.section-head.row{align-items:start}.section-head.row>button{display:none}.manifest h2{font-size:42px}.page{padding:24px 13px 70px}.title-line h1{font-size:40px}.tabs{gap:26px}.product-grid{grid-template-columns:1fr 1fr;gap:30px 10px}.product-copy strong{font-size:17px}.product-copy small{min-height:31px}.quick{font-size:22px}.collection-grid{grid-template-columns:1fr}.collection-grid img{height:470px}.pdp-grid{display:flex;flex-direction:column}.thumbs{display:none}.product-page .crumbs{margin-bottom:12px}.pdp-main{order:1}.pdp-main img{height:62vh;min-height:450px}.pdp-info{order:2}.pdp-title h1{font-size:31px}.desktop-add{display:none}.mobile-size{display:block;position:sticky;bottom:10px;z-index:5}.mini-products{overflow:auto}.pdp-story{grid-template-columns:1fr;margin-top:45px}.pdp-story img{height:480px}.pdp-story div{padding:50px 10px}.pdp-story h2{font-size:42px}.menu-panel{width:100vw}.menu-body{grid-template-columns:45% 55%;height:calc(100% - 64px)}.menu-first,.menu-second{padding:19px 15px}.menu-first button,.menu-second button{font-size:12px}.menu-picture{display:none}.search-panel{padding:40px 20px}.search-panel input{font-size:29px}.search-results{grid-template-columns:1fr 1fr}.quick-panel{width:100%;padding:18px}.quick-content{display:block;margin-top:40px}.quick-content>img{height:40vh}.quick-content h2{font-size:30px}.mobile-overlay{align-items:flex-end}.mobile-overlay .overlay-bg{background:rgba(0,0,0,.55)}.size-sheet{display:block;position:relative;background:white;width:100%;padding:18px 16px 24px;border-radius:14px 14px 0 0;animation:up .25s ease}.size-sheet>i{display:block;width:42px;height:4px;background:#bbb;border-radius:4px;margin:-8px auto 20px}.size-sheet .close{position:absolute;right:15px;top:12px}.sheet-head{display:flex;justify-content:space-between;margin:18px 0}.sheet-head button{text-decoration:underline}.size-option{display:flex;justify-content:space-between;width:100%;padding:16px;border:1px solid #ddd;border-bottom:0}.size-option.active{box-shadow:inset 0 0 0 1px #111}.size-option b{font-weight:400}.side-panel{padding:25px 18px}.cart-recs img{height:160px}footer{grid-template-columns:1fr 1fr;padding:50px 25px 25px}footer .footer-brand{grid-column:1/-1}@keyframes up{from{transform:translateY(50px);opacity:.5}}}
@media(max-width:520px){.promo{font-size:8px}.header-actions{gap:10px}.header-actions button{font-size:19px}.logo{font-size:17px}.hero{height:68vh}.hero-copy h1{font-size:48px}.hero-copy p{font-size:9px}.category-card{min-width:88vw;height:450px}.section-head h2,.section-head h1{font-size:32px}.product-image img{aspect-ratio:.82}.product-copy{width:100%;padding-right:25px}.price{font-size:17px}.quick{bottom:9px}.title-line{display:block}.title-line span{display:block;margin:3px 0}.catalog-tools{padding-bottom:18px}.collection-grid img{height:400px}.collection-grid h2{font-size:29px}.menu-first button,.menu-second button{padding:7px 0}.pdp-main img{height:54vh}.pdp-info h2{margin:8px 0}.pdp-title{margin-top:3px}.pdp-story img{height:360px}.search-results{grid-template-columns:1fr}.quick-content>img{height:34vh}footer{grid-template-columns:1fr}footer .footer-brand{grid-column:auto}footer small{grid-column:1}}

/* Product-list variants and the add-to-cart flow */
.menu-panel{transition:width .3s ease}.menu-panel.compact{width:360px}.menu-panel.compact .menu-body{grid-template-columns:1fr}.menu-back{font-size:9px!important;letter-spacing:.12em;color:#777;margin-bottom:8px}.menu-top b{white-space:nowrap}
.product-image .color-change{position:absolute;left:12px;bottom:12px;background:rgba(255,255,255,.91);padding:6px 9px;font-size:9px;letter-spacing:.04em;opacity:0;transform:translateY(4px);transition:.2s}.product-card:hover .color-change{opacity:1;transform:none}.product-copy{gap:3px}.product-link{display:flex;flex-direction:column;text-align:left;padding:0}.plp-swatches{display:flex;align-items:center;gap:8px;margin:10px 0 9px}.plp-swatches button{width:17px;height:17px;border:1px solid #d4d1ca;box-shadow