2{font:400 50px/1.1 var(--serif);text-transform:uppercase;margin:15px 0 22px}.rich-intro span,.rich-pair span{color:#666;line-height:1.7}.rich-wide{width:100%;height:min(72vw,850px);object-fit:cover}.night-story .rich-wide{object-position:center}.rich-pair{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:7vw;margin-top:12px}.rich-pair img{width:100%;height:670px;object-fit:cover}.rich-pair>div{padding:6vw;text-align:center}.rich-pair h3{font:400 37px/1.2 var(--serif);margin:14px 0 20px}.overlay{position:fixed;inset:0;z-index:100;display:flex}.overlay-bg{position:absolute;inset:0;background:rgba(0,0,0,.48);width:100%;height:100%}.menu-panel{position:relative;background:white;width:min(1030px,82vw);height:100%;animation:slide .25s ease}.menu-top{height:78px;border-bottom:1px solid #ddd;display:flex;align-items:center;gap:30px;padding:0 30px}.menu-top button,.close{width:30px}.menu-top button svg,.close svg{width:27px;height:27px}.menu-top>span{display:flex;align-items:center;gap:8px}.menu-top>span svg{width:21px}.menu-body{display:grid;grid-template-columns:280px 320px 1fr;height:calc(100% - 78px)}.menu-first,.menu-second{padding:32px;border-right:1px solid #eee;display:flex;flex-direction:column;align-items:stretch}.menu-first button,.menu-second button{text-align:left;padding:8px 0}.menu-first button{display:flex;justify-content:space-between;font-size:16px}.menu-first button svg{width:17px;height:17px}.menu-first .sale{color:#df342c}.menu-first .active{font-weight:600}.menu-first hr{width:100%;border:0;border-top:1px solid #ddd;margin:18px 0}.menu-second p{text-transform:uppercase;color:#bf8c76;font-weight:600}.menu-second button{font-size:15px}.menu-second button svg{width:16px;height:16px}.menu-back svg{transform:rotate(180deg)}.menu-picture{padding:32px;position:relative}.menu-picture img{height:78%;object-fit:cover}.menu-picture button{position:absolute;bottom:13%;left:65px;color:#fff;border-bottom:1px solid #fff;padding-bottom:5px;font-size:10