}.product-card{position:relative;min-width:0}.product-image{width:100%;padding:0;display:block;position:relative;overflow:hidden;background:#f3f1ed}.product-image img{aspect-ratio:1/1.08;object-fit:cover;transition:.5s}.product-image:hover img{transform:scale(1.025)}.product-image span{position:absolute;left:10px;top:10px;background:#fff;padding:5px 7px;font-size:8px;letter-spacing:.08em}.heart{position:absolute;right:12px;top:11px;z-index:2;color:#fff;filter:drop-shadow(0 1px 2px #0008)}.heart svg{width:34px;height:34px;stroke-width:1.2}.heart.liked{color:#9d654b}.product-copy{display:flex;flex-direction:column;text-align:left;width:calc(100% - 42px);padding:13px 0}.product-copy strong{font:400 20px var(--serif)}.product-copy small{color:#999;margin-top:4px}.price{font-size:20px}.price del{font-size:13px;color:#999;margin-left:8px}.quick{position:absolute;right:3px;bottom:12px;width:35px;height:35px}.quick>svg{width:31px;height:31px}.quick i{position:absolute;right:-2px;bottom:-2px;background:#fff;border-radius:50%;width:16px;height:16px;display:grid;place-items:center}.quick i svg{width:12px;height:12px}.manifest{background:#f1eee8;text-align:center;padding:115px 20px}.manifest h2{font:400 51px var(--serif);margin:0 0 22px}.manifest span{line-height:1.8;color:#5d5e5c}.manifest button{margin:35px auto 0}.page{padding:45px 28px 100px;min-height:700px}.crumbs{font-size:10px;color:#888;margin-bottom:30px}.title-line{display:flex;align-items:end;gap:30px}.title-line h1{font:400 53px var(--serif);margin:0}.title-line span{color:#999;margin-bottom:12px}.tabs{display:flex;gap:54px;overflow:auto;border-bottom:1px solid #ddd;margin-top:25px}.tabs button{white-space:nowrap;padding:13px 0 18px;border-bottom:1.5px solid transparent}.tabs button.active{font-weight:600;border-color:#111}.catalog-tools{display:flex;justify-content:space-between;align-items:center;padding:22px 0 28px}.catalog-tools select{border:0;background:#fff;padding:10px 25px 10px 0}.catalog-tools button{font-weight:600;font-size:16px;display:flex;align-items:center;gap:10px}.catalog-tools button svg{width:24px;height:24px}.collections.page{max-width:1280px;margin:auto}.collections .section-head{padding-top:20px}.center-tabs{display:flex;justify-content:center;gap:55px;border-bottom:1px solid var(--line);margin-bottom:30px}.center-tabs button{padding:10px 12px 15px;font-size:11px;border-bottom:1px solid transparent}.center-tabs button.active{border-color:#111}.collection-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.collection-grid article{border:1px solid #ddd}.collection-grid button{width:100%;padding:0;text-align:left}.collection-grid img{height:530px;object-fit:cover}.collection-grid article div{padding:24px}.collection-grid h2{font:400 31px var(--serif);text-transform:uppercase;margin:0 0 10px}.collection-grid p{color:#666}.collection-grid span{display:flex;align-items:center;gap:9px;font-size:9px;letter-spacing:.12em;margin-top:28px}.collection-grid span svg{width:16px;height:16px}.pdp-grid{display:grid;grid-template-columns:74px minmax(400px,1fr) minmax(350px,.58fr);gap:24px}.pdp-grid.without-thumbs{grid-template-columns:minmax(520px,1.6fr) minmax(350px,.72fr)}.thumbs{display:flex;flex-direction:column;gap:16px}.thumbs button{padding:0;border:1px solid transparent}.thumbs button.active{border-color:#111}.thumbs img{height:94px;object-fit:cover}.pdp-main img{height:calc(100vh - 170px);min-height:620px;object-fit:cover}.pdp-info{padding:0 8px}.badge{border:1px solid #aaa;padding:4px 6px;display:inline-block}.pdp-title{display:flex;justify-content:space-between;gap:15px;margin-top:16px}.pdp-title h1{font:400 31px/1.08 var(--serif);margin:0}.pdp-title>div{display:flex}.pdp-title button svg{width:27px;height:27px}.pdp-info h2{font:400 23px var(--serif)}.pdp-info>p{font-size:12px;line-height:1.55}.pdp-info>small{color:#777}.pdp-info>label{display:flex;justify-content:space-between;margin:20px 0 9px;font-size:11px}.pdp-info>label button{text-decoration:underline}.swatches{display:flex;gap:12px}.swatches button{width:34px;height:34px;border:1px solid #ddd;background:#fff}.product-swatches button.active{outline:1px solid #111;outline-offset:2px}.sizes{border:1px solid #bbb}.sizes button{width:100%;display:flex;justify-content:space-between;padding:12px;border-bottom:1px solid #ddd;text-align:left}.sizes button:last-child{border:0}.sizes button.active{box-shadow:inset 0 0 0 1px #111}.primary{background:var(--dark);color:#fff;width:100%;padding:17px;margin-top:16px;font-size:11px;letter-spacing:.06em}.mobile-size{display:none}.stores{padding:18px 0;text-decoration:underline;font-size:11px;display:flex;align-items:center;gap:8px}.stores svg{width:18px;height:18px}.stores svg:last-child{width:15px}.pdp-info h3{font-size:11px;font-weight:500}.bundle{margin-top:12px}.mini-products{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mini-products button{text-align:left}.mini-products img{aspect-ratio:1/1.2;object-fit:cover}.mini-products span{display:block;font-size:8px;margin-top:5px}.mini-products b{font-size:9px}.accordion{border-top:1px solid #ddd}.accordion>button{width:100%;display:flex;justify-content:space-between;padding:15px 0;font-size:11px}.accordion>button svg{width:16px;height:16px}.accordion p{font-size:11px;color:#666;line-height:1.5}.rich-content{margin-top:100px}.rich-intro{max-width:680px;text-align:center;margin:0 auto 55px}.rich-intro p,.rich-pair p{font-size:9px;letter-spacing:.17em;color:#8f765e}.rich-intro h