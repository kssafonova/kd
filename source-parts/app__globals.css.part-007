-items:center}.plp-modal>.close svg{width:22px;height:22px}.plp-modal-media{min-height:0;height:52vh;flex:0 0 52vh}.plp-modal-media>img{object-fit:cover}.plp-modal-info{padding:34px 48px 38px}.plp-modal-info>small{display:none}.plp-modal-info h2{font:400 21px/1.15 var(--serif);text-transform:uppercase;margin:8px 0}.plp-modal-info .modal-note{font-size:11px}.plp-modal-info .modal-price{margin:12px 0 16px}.plp-modal-info .modal-price b{font-size:18px;color:#111}.plp-modal-info>p{font-size:10px;text-transform:uppercase}.plp-modal-info>.sheet-head{margin:20px 0 8px}.plp-modal-info>.sheet-head span{font-size:10px}.plp-modal-info .modal-sizes{border-left:0;border-right:0}.plp-modal-info .size-option{min-height:45px}.plp-modal-info .primary{padding:14px;margin-top:16px}.plp-modal-info .stores{padding-bottom:0}}

.editorial-page{background:#fff}.editorial-cover{margin:0;height:calc(100vh - 109px)}.editorial-cover>div{bottom:auto;top:50%;transform:translate(-50%,-50%)}.editorial-cover h1{font-size:clamp(50px,6vw,88px);letter-spacing:.12em}.editorial-cover p{letter-spacing:.5em}.editorial-words{padding-top:70px;padding-bottom:70px}.editorial-words p{font-size:20px}.editorial-detail{width:min(1180px,82vw);height:72vh;margin:0 auto}.editorial-words.narrow{padding:45px 25px 80px}.editorial-split{max-width:1180px;margin:0 auto;gap:12px}.editorial-split img{height:720px}.editorial-products{max-width:1440px;margin:0 auto}.editorial-products-head h2{font-size:38px}

@media(max-width:900px){.home-shelf{padding-top:35px}.shelf-title{align-items:flex-start}.shelf-title h2{font-size:25px}.shelf-title>button{display:none}.home-shelf .category-grid{display:flex;height:auto}.home-shelf .category-card{min-width:72vw;height:410px}.plp-modal{display:flex;flex-direction:column}.plp-modal-media{flex:0 0 34vh}.editorial-cover h1{font-size:42px;letter-spacing:.08em}.editorial-detail{width:100%;height:62vh}.editorial-split img{height:52vh}.pdp-service-links{display:flex;flex-wrap:wrap;gap:12px;margin:18px 0}.pdp-service-links button{font-size:9px;text-decoration:underline}.pdp-description{line-height:1.55!important}}

/* Kultura Doma brand controls and CTA consistency */
:root{--brand:#40565b;--brand-hover:#2f4448;--brand-soft:#f2f0eb;--sale:#ad7448;--dark:var(--brand);--accent:var(--sale)}
button{transition:color .18s ease,background-color .18s ease,border-color .18s ease,opacity .18s ease}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--brand);outline-offset:3px}
.promo{background:var(--brand)}
.primary{background:var(--brand);border:1px solid var(--brand);color:#fff;min-height:48px;display:flex;align-items:center;justify-content:center}
.primary:hover{background:var(--brand-hover);border-color:var(--brand-hover)}
.primary:active{background:#263a3e;border-color:#263a3e}
.secondary{background:#fff;border:1px solid var(--brand);color:var(--brand);min-height:48px}
.secondary:hover{background:var(--brand-soft)}
.bag b{background:var(--sale)}
.toast{background:var(--brand)}
.sale-price,.pdp-price.sale strong{color:var(--sale)}
.sale-price mark,.pdp-price mark,.modal-price mark{background:#f3e7dc;color:#965d36}
footer{background:#202a2b}
.purchase-cta{margin-top:8px;padding:14px}
.purchase-label.mobile-label{display:none}
.added-actions .primary,.added-actions .secondary{margin:0}
.plp-added-modal .primary,.plp-modal .primary,.size-sheet .primary,.bundle .primary,.editorial-products .primary{background:var(--brand);border-color:var(--brand)}
.quick-panel,.quick-content,.quick-heart{display:none!important}

@media(max-width:900px){
  .purchase-cta{position:sticky;bottom:10px;z-index:5;margin-top:16px}
  .purchase-label.desktop-label{display:none}
  .purchase-label.mobile-label{display:inline}
}

/* Editable cart and checkout */
.cart-items article{grid-template-columns:105px minmax(0,1fr) 25px;align-items:start}
.cart-item-copy label{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:10px;font-size:10px;color:#777}
.cart-item-copy select{width:100%;border:0;border-bottom:1px solid #aaa;background:#fff;padding:5px 18px 5px 0;font-size:10px}
.cart-item-bottom{display:flex!important;flex-direction:row!important;align-items:center!important;justify-content:space-between;gap:12px!important;margin-top:5px}
.cart-item-bottom .quantity-control{flex-direction:row;gap:0}
.cart-item-bottom b{font-size:13px;font-weight:400;white-space:nowrap}
.cart .checkout-cta{margin-top:20px}
.checkout-overlay{position:fixed;inset:0;z-index:160;background:#fff;overflow:auto}
.checkout-overlay>header{height:78px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 32px;border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(255,255,255,.97);z-index:2}
.checkout-overlay>header>button{justify-self:start}
.checkout-overlay>header>b{font:400 24px var(--serif);letter-spacing:-.03em}
.checkout-overlay>header>span{justify-self:end;font-size:8px;letter-spacing:.14em;color:#777}
.checkout-overlay>form{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(360px,.68fr);max-width:1360px;margin:0 auto;min-height:calc(100vh - 78px)}
.checkout-main{padding:60px 7vw 100px 4vw}
.checkout-heading p{font-size:9px;letter-spacing:.18em;color:#8d765f}
.checkout-heading h1{font:400 48px var(--serif);margin:8px 0 48px}
.checkout-section{border-top:1px solid var(--line);padding:30px 0 38px}
.checkout-step{display:flex;align-items:center;gap:14px;margin-bottom:2