ase;margin:14px 0}.editorial-words{max-width:760px;margin:0 auto;padding:60px 25px;text-align:center}.editorial-words p{font:400 25px/1.45 var(--serif);margin:0 0 13px}.editorial-words span{color:#777}.editorial-detail{width:calc(100% - 4vw);height:min(72vw,920px);margin:0 2vw;object-fit:cover}.editorial-words.narrow{max-width:680px;padding:36px 25px 55px}.editorial-words.narrow p{font-size:17px;color:#686864}.editorial-split{display:grid;grid-template-columns:1fr 1fr;gap:10px}.editorial-split img{height:650px;object-fit:cover}.editorial-products{padding:95px 3vw 20px}.editorial-products-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:38px}.editorial-products-head p{font-size:12px;letter-spacing:.28em;color:#8d765f;margin:0 0 12px}.editorial-products-head h2{font:400 46px var(--serif);text-transform:uppercase;margin:0}.editorial-products-head>.primary{width:min(360px,35vw);margin:0}.editorial-products .product-grid{grid-template-columns:repeat(4,1fr)}

@media(max-width:900px){.quantity-sizes{display:none}.mobile-size.total-cta{display:flex}.bundle-products{overflow-x:auto;grid-template-columns:repeat(3,42vw)}.post-rich-recommendations{padding:70px 0 25px}.post-rich-recommendations>.section-head h2{font-size:34px}.post-rich-recommendations>div:last-child{display:flex;overflow:auto;gap:10px}.post-rich-recommendations .product-card{min-width:70vw}.editorial-cover{margin:0;height:70vh;min-height:520px}.editorial-cover h1{font-size:48px}.editorial-words{padding:42px 24px}.editorial-words p{font-size:20px}.editorial-detail{width:100%;margin:0;height:70vh}.editorial-split{gap:5px}.editorial-split img{height:45vh}.editorial-products{padding:70px 13px 15px}.editorial-products-head{display:block}.editorial-products-head h2{font-size:36px}.editorial-products-head>.primary{width:100%;margin-top:24px}.editorial-products .product-grid{grid-template-columns:1fr 1fr}.size-sheet>.size-option{padding:0 12px}.size-sheet>.size-option>button{display:block!important}}

/* Reference-aligned merchandising surfaces */
.home-shelf{padding-top:48px;padding-bottom:70px}.shelf-title{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:18px}.shelf-title p{font-size:10px;letter-spacing:.18em;margin:0 0 7px}.shelf-title h2{font:400 30px var(--serif);margin:0}.shelf-title>button{font-size:10px;border-bottom:1px solid;padding-bottom:5px}.home-shelf .category-grid{display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:330px;gap:10px}.home-shelf .category-card,.home-shelf .category-card.c0,.home-shelf .category-card.c1,.home-shelf .category-card.c2,.home-shelf .category-card.c3{grid-column:auto;grid-row:auto;padding:17px}.home-shelf .category-card span{font-size:18px}.home-shelf .category-card b{font-size:8px}

@media(min-width:901px){.product-page.page{padding:26px 18px 90px}.product-page .crumbs{margin-left:8.5%;margin-bottom:15px}.product-page .pdp-grid{grid-template-columns:74px minmax(560px,1.45fr) minmax(360px,.9fr);gap:12px;max-width:1420px;margin:0 auto}.product-page .pdp-grid.without-thumbs{grid-template-columns:minmax(620px,1.6fr) minmax(390px,.82fr)}.product-page .pdp-main{background:#f3f1ed}.product-page .pdp-main img{height:calc(100vh - 142px);min-height:670px;object-fit:cover}.product-page .thumbs{justify-content:flex-end;padding-bottom:2px}.product-page .thumbs img{height:82px}.product-page .pdp-info{padding:4px 25px 0 34px;max-height:calc(100vh - 135px);overflow:auto;scrollbar-width:thin}.product-page .pdp-title{margin-top:12px}.product-page .pdp-title h1{font:400 25px/1.05 var(--serif);text-transform:uppercase;max-width:330px}.product-page .pdp-title button svg{width:23px;height:23px}.product-page .pdp-price{margin:15px 0 8px}.product-page .pdp-price strong{font-size:20px}.pdp-code{display:block;font-size:8px!important;letter-spacing:.06em;margin:0 0 20px}.pdp-description{font-size:11px!important;line-height:1.6!important;color:#555;border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:18px 0;margin:20px 0!important}.product-page .pdp-info>label{margin:15px 0 9px;text-transform:uppercase;font-size:9px}.product-page .swatches button{width:52px;height:52px}.product-page .quantity-sizes{border-color:#aaa}.product-page .quantity-sizes .size-row{min-height:43px}.product-page .desktop-add{margin-top:8px;padding:14px}.pdp-service-links{display:flex;align-items:center;flex-wrap:wrap;gap:0;margin:11px 0 16px}.pdp-service-links button{font-size:8px;text-decoration:underline;padding:0 9px;border-right:1px solid #999}.pdp-service-links button:first-child{padding-left:0}.pdp-service-links button:last-child{border:0}.service-copy{font-size:10px!important;color:#666}.product-page .bundle{margin-top:28px}.product-page .bundle-products{grid-template-columns:repeat(3,1fr)}.product-page .bundle-products img{aspect-ratio:1/1.18}.product-page .bundle-products article>span{font-size:8px}.post-rich-recommendations{padding-left:0;padding-right:0}.standard-pdp .post-rich-recommendations{margin-top:115px}}

@media(min-width:901px){.plp-flow{align-items:stretch;justify-content:flex-end;padding:0}.plp-flow .overlay-bg{background:rgba(0,0,0,.58)}.plp-modal{margin-left:auto;width:min(560px,43vw);height:100%;max-height:none;display:flex;flex-direction:column;box-shadow:-12px 0 45px #0002;animation:slideLeft .25s ease;overflow:auto}.plp-modal>.close{position:fixed;right:20px;top:17px;width:34px;height:34px;border-radius:50%;background:#fff;display:grid;place