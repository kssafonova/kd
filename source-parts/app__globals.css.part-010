xt-align:center;width:auto}
  .view-home .editorial-hero .hero-copy h1{font-size:50px}.view-home .hero-copy span{font-size:15px}
  .hero-mobile-search{display:flex;position:absolute;z-index:3;top:130px;left:20px;right:20px;align-items:center;justify-content:space-between;color:#fff;border-bottom:1px solid rgba(255,255,255,.8);font-size:24px;padding:0 0 8px;text-align:left}.hero-mobile-search svg{width:24px;height:24px}
  .view-home .hero-nav{display:flex;bottom:0;height:55px;padding:0 17px;gap:28px}.view-home .hero-nav button{padding:19px 0 13px}.view-home .hero-dots{bottom:67px}
  .plp-added-modal{width:100%;height:94vh;max-height:94vh;border-radius:15px 15px 0 0;padding:25px 16px 0}.plp-added{align-items:flex-end}.plp-added-modal>.close{position:absolute;right:13px;top:12px}.added-drawer-head{padding-right:40px}.added-drawer-head span{display:none}.plp-added-modal .added-product{grid-template-columns:100px 1fr;gap:14px}.plp-added-modal .added-product img{height:118px}.plp-added-modal .added-recommendations>div{display:flex}.plp-added-modal .added-recommendations button{min-width:44vw}.plp-added-modal .added-recommendations img{height:185px}.added-sticky{padding-bottom:16px}
  .product-info-drawer{width:100%;border-radius:15px 15px 0 0;height:94vh;top:auto;bottom:0}.product-info-drawer>div{padding:28px 18px 55px}
}

/* Favorites, account and checkout map */
.favorite-header b{position:absolute;right:-7px;top:-8px;background:var(--sale);color:#fff;border-radius:50%;width:17px;height:17px;font:9px var(--sans);display:grid;place-items:center}.favorite-header:has(b){color:#9b6548}
.favorites-drawer>p{font-size:12px;letter-spacing:.1em;margin:4px 0 32px}.favorites-drawer .empty{margin-top:22vh}.favorites-drawer .empty>svg{width:42px;height:42px;margin:0 auto 18px}.favorites-drawer .empty span{display:block;line-height:1.6;color:#666}.favorite-list article{display:grid;grid-template-columns:125px minmax(0,1fr) 22px;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);align-items:start}.favorite-image{padding:0}.favorite-image img{height:148px;object-fit:cover}.favorite-list article>div{display:flex;flex-direction:column;align-items:flex-start;gap:8px;min-width:0}.favorite-title{text-align:left;font:400 15px/1.25 var(--serif);text-transform:uppercase}.favorite-list span{font-size:9px;color:#888}.favorite-list b{font-size:12px;font-weight:400}.favorite-list .secondary{margin-top:auto;min-height:35px;padding:8px 17px;font-size:8px}.favorite-remove{padding:2px}.favorite-remove svg{width:16px;height:16px}
.account-fields{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}.account-fields input{min-width:0}.account .primary{margin-top:20px}.account .link{margin-top:4px}
.checkout-map{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(190px,.55fr);border:1px solid #cfcec9;margin-top:20px;min-height:330px}.map-canvas{position:relative;overflow:hidden;background-color:#e9e6df;background-image:linear-gradient(32deg,transparent 48%,#d3cfc6 49%,#d3cfc6 51%,transparent 52%),linear-gradient(145deg,transparent 47%,#d7d4cc 48%,#d7d4cc 50%,transparent 51%),linear-gradient(85deg,transparent 49%,#ddd9d0 50%,transparent 51%);background-size:130px 90px,160px 120px,90px 110px}.map-canvas:before,.map-canvas:after{content:"";position:absolute;border:1px solid rgba(126,116,100,.28);border-radius:50%;left:13%;top:7%;width:70%;height:82%}.map-canvas:after{left:27%;top:22%;width:42%;height:51%}.river{position:absolute;left:56%;top:-20%;width:36px;height:150%;background:#c5d6d8;transform:rotate(9deg);opacity:.75}.map-label{position:absolute;font-size:7px;letter-spacing:.16em;color:#8b8479}.map-label.moscow{left:38%;top:47%}.map-label.center{left:24%;top:17%}.map-pin{position:absolute;z-index:2;width:34px;height:34px;color:var(--brand)}.map-pin svg{width:34px;height:34px;fill:#fff;filter:drop-shadow(0 2px 5px #0003)}.map-pin span{position:absolute;inset:7px 0 0;text-align:center;font-size:9px;font-weight:600}.map-pin.active{color:var(--sale);transform:scale(1.15)}.map-pin.pin-0{left:39%;top:40%}.map-pin.pin-1{left:19%;top:62%}.map-pin.pin-2{right:20%;top:24%}.map-points{background:#fff;padding:20px 15px}.map-points>p{font-size:8px;letter-spacing:.09em;margin:0 0 10px}.map-points>button{width:100%;display:grid;grid-template-columns:25px 1fr;gap:8px;text-align:left;padding:11px 6px;border-top:1px solid #ddd}.map-points>button>b{width:22px;height:22px;border:1px solid var(--brand);border-radius:50%;display:grid;place-items:center;font-size:8px}.map-points>button>span{font-size:9px}.map-points small{display:block;color:#888;margin-top:4px}.map-points>button.active{background:#f3f0ea}.map-points>button.active>b{background:var(--brand);color:#fff}

/* More restrained premium typography */
.hero-copy h1{font-size:clamp(48px,5.7vw,84px)}.section-head h2,.section-head h1{font-size:clamp(34px,3.6vw,54px)}.title-line h1{font-size:45px}.manifest h2{font-size:44px}

@media(max-width:900px){
  body{font-size:11px}.logo{font-size:18px}.view-home .editorial-hero .hero-copy h1,.hero-copy h1,.hero.left .hero-copy h1{font-size:38px}.hero-copy span{font-size:13px}.hero-copy p{font-size:8px}.hero-copy button{font-size:9px;margin-top:12px}
  .title-line h1{font-size:32px}.section-head h2,.section-head h1{font-size:29px}.editorial h2{font-size:37px}.manifest h2{font-size:32px}.manifest{padding:75px 18px}.collection-grid h2{font-size:24px}.pdp-title h1{font-size:25px}.rich-intro h2{font-size:32px}.editorial-cover h1{font-size:34px}.editor