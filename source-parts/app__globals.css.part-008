5px}
.checkout-step i{width:28px;height:28px;border:1px solid var(--brand);border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:11px;color:var(--brand)}
.checkout-step h2{font:400 22px var(--serif);margin:0}
.checkout-fields,.checkout-address{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.checkout-fields label,.checkout-address label{display:flex;flex-direction:column;gap:7px;font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:#666}
.checkout-fields input,.checkout-address input{height:44px;border:1px solid #c9c8c3;padding:0 12px;background:#fff}
.checkout-options{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:22px}
.checkout-options>label{display:flex;align-items:flex-start;gap:12px;border:1px solid #d3d2ce;padding:17px;cursor:pointer}
.checkout-options>label.active{border-color:var(--brand);box-shadow:inset 0 0 0 1px var(--brand)}
.checkout-options input{accent-color:var(--brand);margin-top:3px}
.checkout-options span{display:flex;flex-direction:column;gap:6px}
.checkout-options b{font-weight:400}
.checkout-options small{color:#777;font-size:10px}
.checkout-summary{background:#f4f2ee;padding:55px 40px 50px;position:sticky;top:78px;align-self:start;min-height:calc(100vh - 78px)}
.summary-title{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfcfca;padding-bottom:16px}
.summary-title h2{font:400 24px var(--serif);margin:0}
.summary-title button{font-size:9px;text-decoration:underline;letter-spacing:.08em}
.summary-items article{display:grid;grid-template-columns:78px 1fr;gap:13px;padding:16px 0;border-bottom:1px solid #d6d5d1}
.summary-items img{width:78px;height:92px;object-fit:cover}
.summary-items article>div{display:flex;flex-direction:column;gap:5px}
.summary-items strong{font-weight:400;font-size:11px}
.summary-items span{font-size:9px;color:#777}
.summary-items b{font-weight:400;font-size:11px;margin-top:auto}
.checkout-summary dl{margin:25px 0}
.checkout-summary dl>div{display:flex;justify-content:space-between;margin:12px 0;font-size:11px}
.checkout-summary dt,.checkout-summary dd{margin:0}
.checkout-summary .summary-total{font-size:17px;border-top:1px solid #cfcfca;padding-top:18px;margin-top:18px}
.checkout-consent{display:flex;align-items:flex-start;gap:10px;font-size:9px;color:#666;line-height:1.5;margin:18px 0}
.checkout-consent input{accent-color:var(--brand)}
.checkout-security{display:block;text-align:center;color:#777;line-height:1.5;margin-top:14px}

@media(min-width:901px){.plp-flow{justify-content:flex-end!important;align-items:stretch!important;padding:0!important}.plp-flow .plp-modal{margin:0 0 0 auto!important;height:100vh!important;max-height:100vh!important}}
@media(max-width:900px){
  .cart-items article{grid-template-columns:88px minmax(0,1fr) 22px}.cart-items img{width:88px;height:105px}
  .checkout-overlay>header{height:64px;padding:0 15px}.checkout-overlay>header>b{font-size:19px}.checkout-overlay>header>span{display:none}
  .checkout-overlay>form{display:block}.checkout-main{padding:35px 15px 20px}.checkout-heading h1{font-size:38px;margin-bottom:30px}
  .checkout-fields,.checkout-address,.checkout-options{grid-template-columns:1fr}.checkout-section{padding:25px 0}.checkout-step h2{font-size:20px}
  .checkout-summary{position:static;min-height:0;padding:35px 16px 45px}.summary-items article{grid-template-columns:70px 1fr}.summary-items img{width:70px;height:82px}
}

/* Zara Home-style progressive navigation: level 2 replaces level 1 */
.navigation-overlay{pointer-events:none;background:transparent}
.navigation-overlay .overlay-bg{display:none}
.zara-menu{pointer-events:auto;width:365px!important;max-width:88vw;box-shadow:9px 0 28px rgba(0,0,0,.06);background:rgba(255,255,255,.985)}
.zara-menu .menu-top{height:78px;padding:0 28px}
.zara-menu .menu-top b{display:none}
.zara-menu .menu-body{display:block;height:calc(100% - 78px);overflow-y:auto}
.zara-menu .menu-first,.zara-menu .menu-second{border:0;padding:34px 30px 50px;min-height:100%;display:flex;flex-direction:column;align-items:stretch}
.zara-menu .menu-first button,.zara-menu .menu-second button{min-height:0;padding:8px 0;font-size:15px;text-transform:uppercase;display:flex;align-items:center;justify-content:space-between;text-align:left}
.zara-menu .menu-first button svg,.zara-menu .menu-second button svg{width:14px;height:14px;flex:none}
.zara-menu .menu-feature{font-weight:500}
.zara-menu .menu-first .sale{color:#d52d34;margin-top:10px}
.zara-menu hr{margin:18px 0;width:100%;border:0;border-top:1px solid #ddd}
.zara-menu .menu-second{animation:menuReplace .2s ease}
.zara-menu .menu-back{justify-content:flex-start!important;gap:8px;font-weight:500!important;font-size:16px!important;margin:0 0 26px;text-transform:uppercase}
.zara-menu .menu-back svg{transform:rotate(180deg)}
.zara-menu .menu-second .view-all{font-weight:600;border-bottom:1px solid #ddd;margin-bottom:10px;padding-bottom:16px}
@keyframes menuReplace{from{opacity:.25;transform:translateX(9px)}}

@media(max-width:900px){
  .zara-menu{width:88vw!important;max-width:360px}
  .zara-menu .menu-top{height:64px;padding:0 16px}
  .zara-menu .menu-first,.zara-menu .menu-second{padding:24px 18px 35px}
  .zara-menu .menu-first button,.zara-menu .menu-second button{font-size:13px;padding:8px 0}
}

/* Immersive home editorial supplied by the client */
.view-home .header{position:absolute;top:31px;left:0;width:100%;background:transparent;color:#fff;border:0;