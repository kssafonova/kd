pan{font-size:10px}.rich-wide{height:62vh}.rich-pair{display:block}.rich-pair img{height:52vh}.rich-pair>div{padding:45px 20px}.rich-pair h3{font-size:25px}
  .menu-top button svg,.close svg{width:20px;height:20px}.menu-top button,.close{width:36px;height:36px;display:grid;place-items:center}.zara-menu .menu-top{height:56px;padding:0 10px}.zara-menu .menu-first,.zara-menu .menu-second{padding:20px 16px 32px}.zara-menu .menu-first button,.zara-menu .menu-second button{font-size:11px;line-height:1.25;padding:9px 0}.zara-menu .menu-back{font-size:12px!important;margin-bottom:18px}
  .side-panel{width:100%;padding:20px 16px}.side-panel .close{right:10px;top:10px}.side-panel>p{font-size:10px;margin:3px 0 30px}.account h2{font-size:27px}.account>span{font-size:10px}.account input{font-size:12px;padding:12px 2px}.favorites-drawer .empty h2,.empty h2{font-size:27px}.favorite-list article{grid-template-columns:86px minmax(0,1fr) 18px;gap:10px}.favorite-image img{height:105px}.favorite-title{font-size:11px}.favorite-list span{font-size:8px}
  .search-panel{height:100%;max-height:none;padding:28px 16px}.search-panel>div:first-child{gap:8px}.search-panel>div:first-child>svg{width:20px;height:20px}.search-panel input{font-size:20px;padding:12px 0}.search-panel>div:first-child button svg{width:20px;height:20px}.search-panel p{font-size:9px}.search-results{grid-template-columns:1fr 1fr;gap:15px 8px}.search-results span,.search-results b{font-size:9px}
  .plp-modal-media{flex-basis:31vh}.plp-modal-info{padding:22px 15px 18px}.plp-modal-info h2{font-size:20px}.plp-modal-info .modal-price b{font-size:16px}.quick-description{font-size:9px!important}.quick-info-link{font-size:8px}.sheet-head{font-size:9px}.quantity-sizes .size-row{min-height:46px}.quantity-sizes .size-row>button{font-size:9px}.stock-actions>button:first-child{font-size:6px!important}.quantity-control{height:30px}.quantity-control button{width:29px!important;height:28px!important}.quantity-control span{min-width:20px;font-size:9px}.stores{font-size:8px;padding:14px 0}.stores svg{width:16px;height:16px}
  .plp-added-modal{padding:21px 14px 0}.added-drawer-head .added-kicker{font-size:9px}.plp-added-modal .added-product{grid-template-columns:88px 1fr;gap:12px}.plp-added-modal .added-product img{height:104px}.plp-added-modal .added-product h2{font-size:15px}.plp-added-modal .added-product span{font-size:8px}.plp-added-modal .added-recommendations>p{font-size:9px}.plp-added-modal .added-recommendations button{min-width:42vw}.plp-added-modal .added-recommendations img{height:160px}.added-sticky{padding-bottom:12px}
  .cart-items article{grid-template-columns:78px minmax(0,1fr) 18px;gap:10px}.cart-items img{width:78px;height:96px}.cart-items article span,.cart-item-copy label{font-size:8px}.cart-item-copy strong{font-size:10px}.cart-item-copy select{font-size:8px;max-width:100%}.cart-total{font-size:15px}.delivery{font-size:9px;padding:15px;margin:18px 0}.recent-cart img{height:160px}
  .checkout-overlay>header{height:56px;padding:0 12px}.checkout-overlay>header>b{font-size:15px}.checkout-main{padding:28px 13px 18px}.checkout-heading p{font-size:8px}.checkout-heading h1{font-size:28px;margin:6px 0 26px}.checkout-section{padding:22px 0}.checkout-step{gap:10px;margin-bottom:18px}.checkout-step i{width:24px;height:24px;font-size:9px}.checkout-step h2{font-size:16px}.checkout-fields,.checkout-address{gap:13px}.checkout-fields label,.checkout-address label{font-size:8px}.checkout-fields input,.checkout-address input{height:42px;font-size:11px}.checkout-options>label{padding:13px}.checkout-options b{font-size:10px}.checkout-options small{font-size:8px}.checkout-map{min-height:0}.map-canvas{min-height:235px}.map-points{padding:14px 10px}.checkout-summary{padding:28px 14px 38px}.checkout-summary .summary-title h2{font-size:18px}.summary-items strong{font-size:9px}.summary-items span{font-size:8px}.checkout-summary dl>div{font-size:9px}.checkout-summary .summary-total{font-size:14px}.checkout-consent{font-size:8px}
  footer{padding:42px 18px 22px;gap:28px 18px}footer .footer-brand .logo{font-size:18px;margin-bottom:22px}footer p{font-size:9px}footer button,footer a{font-size:9px}footer small{font-size:8px}
  .toast{left:12px;right:12px;bottom:18px;transform:none;text-align:center;font-size:9px;padding:11px 14px}
}

@media(max-width:380px){
  .header,.view-home .header{padding:0 8px}.logo{font-size:13px}.header-actions{gap:2px}.header-actions button{width:21px}.header-actions svg,.header-actions .bag svg{width:17px;height:17px}.header-left{gap:6px}.boutiques svg{width:17px;height:17px}.hamburger{width:18px}
  .view-home .editorial-hero .hero-copy h1,.hero-copy h1,.hero.left .hero-copy h1{font-size:29px}.hero-copy span{font-size:11px}
  .product-copy strong{font-size:12px}.price{font-size:12px}.bundle-products{grid-template-columns:repeat(3,43vw)}
}
