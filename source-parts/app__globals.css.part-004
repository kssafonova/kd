:0 0 0 2px white}.plp-swatches button.active{outline:1px solid #202220;outline-offset:2px}.product-image img{transition:opacity .18s ease,transform .5s}.plp-size-panel{position:relative;background:#fff;margin-left:auto;width:min(580px,96vw);height:100%;padding:31px;overflow:auto;animation:slideLeft .25s ease}.plp-size-panel>.close{position:absolute;top:20px;right:24px}.plp-flow-product{display:grid;grid-template-columns:180px 1fr;gap:24px;align-items:center;padding:40px 0 25px;border-bottom:1px solid #ddd}.plp-flow-product img{width:180px;height:205px;object-fit:cover}.plp-flow-product small{font-size:9px;letter-spacing:.12em;color:#777}.plp-flow-product h2{font:500 30px/1.05 var(--serif);margin:10px 0}.plp-flow-product p{color:#777}.plp-flow-product b{font-weight:500}.flow-handle{display:none}.menu-top b{position:absolute;left:50%;transform:translateX(-50%);font:500 22px var(--serif)}.menu-second{animation:menuReveal .22s ease}.menu-second p{font-size:10px;letter-spacing:.14em}.menu-second button{display:flex;justify-content:space-between}.menu-second .view-all{font-weight:600;border-bottom:1px solid #ddd;margin-bottom:8px;padding-bottom:15px}.menu-picture{overflow:hidden}.menu-picture img{height:100%;filter:brightness(.85);animation:imageReveal .28s ease}.menu-picture>div{position:absolute;left:58px;right:45px;bottom:65px;color:#fff}.menu-picture small,.menu-picture strong{display:block}.menu-picture small{font-size:8px;letter-spacing:.15em}.menu-picture strong{font:500 32px var(--serif);margin:7px 0}.menu-picture>div button{position:static;color:#fff;padding:0 0 5px}.hero-copy h1{max-width:820px}.hero.left .hero-copy{max-width:820px}.hero.left .hero-copy h1{font-size:clamp(54px,6vw,92px)}@keyframes menuReveal{from{transform:translateX(-8px);opacity:.2}}@keyframes imageReveal{from{transform:scale(1.015);opacity:.6}}

@media(max-width:900px){.product-image .color-change{opacity:1;transform:none}.plp-flow{align-items:flex-end}.plp-size-panel{width:100%;height:auto;max-height:92vh;border-radius:15px 15px 0 0;padding:18px 16px 25px;animation:up .25s ease}.flow-handle{display:block;width:42px;height:4px;border-radius:4px;background:#bdbdbd;margin:0 auto 12px}.plp-flow-product{grid-template-columns:105px 1fr;gap:15px;padding:21px 0 17px}.plp-flow-product img{width:105px;height:118px}.plp-flow-product h2{font-size:23px;margin:7px 0}.plp-size-panel>.close{right:15px;top:12px}.menu-top b{font-size:17px}.menu-body{grid-template-columns:42% 58%}.menu-second p{font-size:8px}.hero.left .hero-copy h1{font-size:52px}}
@media(max-width:520px){.plp-swatches button{width:15px;height:15px}.product-image .color-change{font-size:7px;bottom:8px;left:8px}.hero.left .hero-copy h1{font-size:42px}.menu-top b{font-size:15px}.menu-first,.menu-second{padding:15px 12px}}
@media(max-width:900px){.menu-panel.compact{width:70vw}.menu-panel.compact .menu-body{grid-template-columns:1fr}}

/* Zara Home / Togas inspired promotional PLP flow */
.product-image .image-discount{position:absolute;left:10px;top:38px;background:#ae7650;color:#fff;padding:5px 8px;font-size:9px;font-style:normal;letter-spacing:.06em}.sale-price{color:#ad7144}.sale-price del{color:#92928e}.sale-price mark{background:#f2e5da;color:#9e6242;padding:4px 7px;margin-left:10px;font-size:11px}.plp-flow{align-items:center;justify-content:center;padding:24px}.plp-modal{position:relative;background:#fff;width:min(940px,94vw);max-height:92vh;display:grid;grid-template-columns:1.08fr .92fr;box-shadow:0 20px 70px #0004;animation:modalIn .22s ease;overflow:auto}.plp-modal>.close,.plp-added-modal>.close{position:absolute;right:22px;top:20px;z-index:3}.plp-modal-media{position:relative;min-height:650px;background:#f1efea}.plp-modal-media>img{height:100%;object-fit:cover}.plp-modal-media>span{position:absolute;left:18px;top:18px;background:#ae7650;color:#fff;padding:7px 10px;font-size:11px}.plp-modal-info{padding:58px 48px 35px}.plp-modal-info>small{font-size:9px;letter-spacing:.14em;color:#8b8b87}.plp-modal-info h2{font:400 31px/1.13 var(--serif);margin:14px 0 8px}.modal-note{color:#8c8c88;margin:0 0 20px}.modal-price{display:flex;align-items:center;gap:12px;margin:18px 0 30px}.modal-price b{font-size:22px;font-weight:400;color:#a86d42}.modal-price del{color:#94948f}.modal-price mark{background:#f2e5da;color:#a06443;padding:5px 8px}.plp-modal-info>.sheet-head{margin-top:26px}.modal-sizes{border:1px solid #bbb}.modal-sizes .size-option{border:0;border-bottom:1px solid #ddd}.modal-sizes .size-option:last-child{border:0}.plp-added{align-items:center;justify-content:center;padding:24px}.plp-added-modal{position:relative;background:#fff;width:min(1000px,95vw);max-height:93vh;overflow:auto;padding:38px 44px 30px;box-shadow:0 20px 70px #0004;animation:modalIn .22s ease}.added-kicker{letter-spacing:.1em;font-size:12px;margin:0 0 24px}.added-product{display:grid;grid-template-columns:145px 1fr 30px;align-items:center;gap:24px;border-bottom:1px solid #ddd;padding-bottom:25px}.added-product img{height:155px;object-fit:cover}.added-product>div{display:flex;flex-direction:column;gap:8px}.added-product h2{font:400 25px/1.2 var(--serif);margin:0}.added-product span{color:#777;font-size:11px}.added-product b{font-weight:400;font-size:16px}.added-product>svg{width:29px;height:29px}.added-actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:22px 0 35px}.added-actions .primary{margin:0}.secondary{border:1px solid #263b3d;padding:16px;font-size:11px;letter-spacing:.06em}.added-rec